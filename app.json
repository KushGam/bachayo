{
  "expo": {
    "name": "LastBag",
    "slug": "lastbag",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "lastbag",
    "userInterfaceStyle": "light",
    "primaryColor": "#D85A30",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lastbag.app",
      "icon": "./assets/images/app-icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "LastBag uses the camera to scan pickup QR codes. LastBag \u0932\u0947 \u092a\u093f\u0915\u0905\u092a\u0915\u093e \u0932\u093e\u0917\u093f QR \u0915\u094b\u0921 \u0938\u094d\u0915\u094d\u092f\u093e\u0928 \u0917\u0930\u094d\u0928 \u0915\u094d\u092f\u093e\u092e\u0947\u0930\u093e \u091a\u093e\u0939\u093f\u0928\u094d\u091b\u0964",
        "NSLocationWhenInUseUsageDescription": "LastBag \u0932\u0947 \u0928\u091c\u093f\u0915\u0915\u093e \u0930\u0947\u0938\u094d\u0915\u094d\u092f\u0942 \u092c\u094d\u092f\u093e\u0917\u0939\u0930\u0942 \u0926\u0947\u0916\u093e\u0909\u0928 \u0924\u092a\u093e\u0908\u0902\u0915\u094b \u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u091b\u0964",
        "NSUserNotificationsUsageDescription": "LastBag \u0932\u0947 \u092a\u093f\u0915\u0905\u092a \u0930\u093f\u092e\u093e\u0907\u0928\u094d\u0921\u0930 \u0930 \u092c\u0941\u0915\u093f\u0919 \u0905\u092a\u0921\u0947\u091f\u0915\u093e \u0932\u093e\u0917\u093f \u0938\u0942\u091a\u0928\u093e \u092a\u0920\u093e\u0909\u0901\u091b\u0964",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["whatsapp", "mailto", "tel", "maps", "comgooglemaps"]
      }
    },
    "android": {
      "package": "com.lastbag.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "backgroundColor": "#D85A30",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/images/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#D85A30"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#D85A30",
          "imageWidth": 180
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "LastBag uses the camera to scan pickup QR codes. LastBag \u0932\u0947 QR \u0915\u094b\u0921 \u0938\u094d\u0915\u094d\u092f\u093e\u0928 \u0917\u0930\u094d\u0928 \u0915\u094d\u092f\u093e\u092e\u0947\u0930\u093e \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u091b\u0964"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LastBag \u0932\u0947 \u0928\u091c\u093f\u0915\u0915\u093e \u092a\u093f\u0915\u0905\u092a \u092c\u093f\u0928\u094d\u0926\u0941\u0939\u0930\u0942 \u092b\u0947\u0932\u093e \u092a\u093e\u0930\u094d\u0928 \u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u092f\u094b\u0917 \u0917\u0930\u094d\u091b\u0964"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon.png",
          "color": "#D85A30"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LastBag \u0932\u0947 \u0915\u092d\u0930 \u092b\u094b\u091f\u094b \u0905\u092a\u0932\u094b\u0921 \u0917\u0930\u094d\u0928 \u0924\u0938\u094d\u092c\u093f\u0930\u0939\u0930\u0942\u092e\u093e \u092a\u0939\u0941\u0901\u091a \u091a\u093e\u0939\u093f\u0928\u094d\u091b\u0964"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7f7daa2d-25da-489e-9378-4495138d3f0c"
      },
      "router": {}
    }
  }
}