# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — local scripts only (e.g. node scripts/seed-demo-accounts.mjs). Never ship in the app.
# SUPABASE_SERVICE_ROLE_KEY=

# ─── Google Sign-In (native — required for EAS / store builds) ───────────────
# Google Cloud Console → APIs & Services → Credentials
#
# 1) Create a Web application OAuth client → paste Client ID here:
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
#
# 2) Create an iOS OAuth client (bundle ID com.lastbag.app) → paste Client ID:
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Optional override if you prefer the reversed scheme explicitly:
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.YOUR_IOS_CLIENT_PREFIX
#
# 3) Create an Android OAuth client (package com.lastbag.app + SHA-1 from
#    `eas credentials` / keystore) — Client ID goes in Supabase only (comma list).
#
# 4) Supabase → Authentication → Providers → Google:
#    - Client IDs: WEB_CLIENT_ID,IOS_CLIENT_ID,ANDROID_CLIENT_ID  (web first)
#    - Client Secret: from the Web client
#    - Enable "Skip nonce check" (required for native iOS Google Sign-In)
#
# Native sign-in shows "LastBag" / Google account picker — not supabase.co.
# Browser OAuth is no longer used on mobile.

# Payment gateways (public)
EXPO_PUBLIC_ESEWA_MERCHANT_CODE=EPAYTEST
EXPO_PUBLIC_KHALTI_PUBLIC_KEY=

# Set these as Supabase Edge Function secrets (never in the client app):
# ESEWA_SECRET_KEY=
# KHALTI_SECRET_KEY=
# ESEWA_MERCHANT_CODE=EPAYTEST
# APP_WEBSITE_URL=https://lastbag.app
# WEBHOOK_SECRET=          # x-webhook-secret header for DB webhooks
# CRON_SECRET=             # x-cron-secret header for scheduled cron invocations
# EXPO_ACCESS_TOKEN=       # optional; required for higher Expo push rate limits

# After `eas init`, add your EAS project ID to .env.local:
# EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-uuid
# (required for Expo push tokens on physical devices)

# Analytics (optional — PostHog)
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Backend API (Vercel Next.js — support contact form, etc.)
# Defaults to https://lastbag.app if unset.
EXPO_PUBLIC_API_URL=https://lastbag.app
