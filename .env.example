# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Payment gateways (public)
EXPO_PUBLIC_ESEWA_MERCHANT_CODE=EPAYTEST
EXPO_PUBLIC_KHALTI_PUBLIC_KEY=

# Set these as Supabase Edge Function secrets (never in the client app):
# ESEWA_SECRET_KEY=
# KHALTI_SECRET_KEY=
# ESEWA_MERCHANT_CODE=EPAYTEST
# APP_WEBSITE_URL=https://bachayo.app
# WEBHOOK_SECRET=          # x-webhook-secret header for DB webhooks
# CRON_SECRET=             # x-cron-secret header for scheduled cron invocations
# EXPO_ACCESS_TOKEN=       # optional; required for higher Expo push rate limits

# After `eas init`, add your EAS project ID to app.json under expo.extra.eas.projectId
# (required for Expo push tokens on physical devices).

# Analytics (optional — PostHog)
# EXPO_PUBLIC_POSTHOG_KEY=
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
